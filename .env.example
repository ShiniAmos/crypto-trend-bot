# Copy to .env (chmod 600 on the VPS). Never commit .env. Never paste keys in chat.
# paper | demo | live
MODE=paper

# Binance keys: one key per environment. Demo keys come from Binance Demo Trading only.
# Permissions: reading + spot trading. Withdrawals OFF, forever. IP-restrict the live key to the VPS.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Telegram: create a bot with @BotFather; chat id from https://api.telegram.org/bot<token>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Website password. Set this on a public server; leave empty on your own PC.
DASHBOARD_PASSWORD=

# AUTO_TRADE=true lets the bot place live entries by itself, with no TRADE reply needed.
# Telegram still reports every buy and sell. Off means live entries wait for your approval.
AUTO_TRADE=false

# How often the bot decides: 4h (validated) or 1h (checks four times as often, same horizons).
# Measured on nine years: 1h gives CAGR 17.9% against 20.7%, Sharpe 1.27 against 1.43.
DECISION_TF=4h
# LEVEL_TF: which closed candle the levels come from. Empty follows DECISION_TF. With
# DECISION_TF=live and LEVEL_TF=1h the channel and ranking refresh every hour and the price is
# checked every LIVE_POLL_SECONDS, so nothing waits on a 4-hour boundary.
LEVEL_TF=
LIVE_POLL_SECONDS=15

# Live money needs this second, separate opt-in (after the Phase 10 demo week).
LIVE_TRADING_CONFIRMED=false
# hard cap the bot sizes against
LIVE_BUDGET_USDT=100
# 1 for the first two weeks, then up to 3
LIVE_MAX_NAMES=1

# Risk (defaults = roadmap v1)
START_EQUITY=10000
RISK_PCT=0.01
MAX_NAMES=3
MAX_WEIGHT=0.30
DAILY_LOSS_HALT=0.03
KILL_DRAWDOWN=0.08
FEE_RATE=0.001
SLIPPAGE_BPS=7
SIGNAL_EXPIRY_HOURS=2

# Research feature flags (P0-P3). Default off = the audited baseline strategy.
# ENABLE_STOP_EXEC: exit intrabar when the bar's low pierces the position's stop, and in demo/live
# rest a STOP_LOSS_LIMIT at the exchange between 4-hour checks.
ENABLE_STOP_EXEC=false
# ENABLE_ABS_MOMENTUM: a candidate must also be up over its own last 30 days, not merely beating a
# falling BTC. Validated on the standard panel, the survivorship-free panel and the held-out half;
# improves return, Sharpe and drawdown on all three. Set false to return to the audited baseline.
ENABLE_ABS_MOMENTUM=true
# ENABLE_BTC_MOMENTUM: also require BTC itself to be up over 30 days. Passes on the
# survivorship-free panel only, so it stays off.
ENABLE_BTC_MOMENTUM=false
# ENABLE_VOLUME_MIN: reject a breakout printed on a day quieter than this multiple of the coin's
# own 20-day average turnover. 0.8 passes all three panels and improves both significance
# measures; 1.0 and 1.2 were rejected. 0 disables it.
ENABLE_VOLUME_MIN=0.8
# ENABLE_BREADTH: rejected - costs 8 points of CAGR and destroys coin-selection significance.
ENABLE_BREADTH=false
# ENABLE_TAKER_MIN: the breakout day must show real buying pressure - at least this share of the
# day's volume hitting the ask. Passes all three panels and improves both significance measures
# on every one of them. 0 disables it.
ENABLE_TAKER_MIN=0.5
# ENABLE_FUNDING_MAX_PCT: skip a breakout whose 7-day perpetual funding is above this percentile
# of the universe - the trade is already crowded with leveraged longs. Passed every panel
# including survivorship-free, beat a 40-draw placebo null 40-0, and survives 2x costs.
ENABLE_FUNDING_MAX_PCT=0.8
