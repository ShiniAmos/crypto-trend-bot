# /etc/systemd/system/crypto-bot-web.service  (the read-only website on port 8601)
[Unit]
Description=Crypto bot website
After=network-online.target

[Service]
User=bot
WorkingDirectory=/opt/bot
EnvironmentFile=/opt/bot/.env
ExecStart=/opt/bot/venv/bin/python -m streamlit run dashboard.py --server.port 8601 --server.address 0.0.0.0 --server.headless true --browser.gatherUsageStats false
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
